# Modelo das variáveis de ambiente do Portal do Aluno P.I
# Copie para .env e preencha. NUNCA versione o arquivo .env.

# --- Obrigatórias ---
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# PostgreSQL (local ou Neon). Com Docker, o docker-compose monta esta URL sozinho.
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/portal_aluno

# Banco criado pelo docker-compose (só usado com Docker). Escolha um usuário e uma senha.
POSTGRES_DB=portal_aluno
POSTGRES_USER=
POSTGRES_PASSWORD=

# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CRIPTOGRAFIA=

# python -c "import secrets; print(secrets.token_urlsafe(32))"
CHAVE_HASH_CPF=

# --- Desenvolvimento local (em produção, remover ou deixar os padrões) ---
DJANGO_DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_SSL_REQUIRE=False
FORCE_HTTPS=False
BEHIND_PROXY=False

# --- Opcionais ---
# Chaves antigas, separadas por vírgula (usadas só durante a rotação de chaves)
CHAVES_CRIPTOGRAFIA_ANTIGAS=
# PROXIES_CONFIAVEIS=1
# HSTS_SECONDS=3600

# Recuperação de senha por e-mail (Gmail + senha de app)
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
